# Required
TMDB_TOKEN=your_tmdb_read_api_bearer_token_here

# Everything below is optional — these are the built-in defaults.
# See movieservice/config.py for the full list.

# Latency budget and connection pool
# REQUEST_TIMEOUT=8.0
# CONNECT_TIMEOUT=3.0
# POOL_MAX_CONNECTIONS=20
# POOL_MAX_KEEPALIVE=10

# Retry policy (attempts includes the first try)
# RETRY_ATTEMPTS=3
# RETRY_BASE_DELAY=0.2
# RETRY_MAX_DELAY=2.0
# RETRY_JITTER=0.25

# Circuit breaker
# BREAKER_FAILURE_THRESHOLD=5
# BREAKER_RESET_SECONDS=20

# Response cache
# CACHE_TTL_SECONDS=60
# CACHE_GENRE_TTL_SECONDS=3600
# CACHE_WATCH_TTL_SECONDS=900
# CACHE_MAX_ENTRIES=512

# Watch availability (JustWatch data via TMDB)
# DEFAULT_WATCH_REGION=US

# Inbound protection
# RATE_LIMIT_MAX_REQUESTS=30
# RATE_LIMIT_WINDOW_SECONDS=3600
# MAX_QUERY_LENGTH=140

# Observability
# LOG_LEVEL=INFO
# SERVICE_NAME=movie-catalog
